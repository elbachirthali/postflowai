generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  name            String
  avatar          String?
  plan            String   @default("FREE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace? @relation("WorkspaceOwner")
  workspaceMember Workspace? @relation("WorkspaceMembers", fields: [workspaceId], references: [id])
  workspaceId     String?

  connectedAccounts ConnectedAccount[]
  posts             Post[]
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  plan      String   @default("FREE")
  createdAt DateTime @default(now())

  owner   User   @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  ownerId String @unique

  members User[] @relation("WorkspaceMembers")
  posts   Post[]
}

model ConnectedAccount {
  id            String   @id @default(uuid())
  platform      String
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  status        String   @default("CONNECTED")
  profileName   String
  profileAvatar String?
  profileUrl    String?
  createdAt     DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model Post {
  id          String   @id @default(uuid())
  baseIdea    String
  mediaUrl    String?
  mediaType   String?
  contentType String   @default("GENERAL")
  status      String   @default("DRAFT")
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  workspaceId String?

  platforms PostPlatform[]
}

model PostPlatform {
  id               String   @id @default(uuid())
  platform         String
  generatedCaption String
  editedCaption    String?
  hashtags         String?
  hookText         String?
  ctaText          String?
  charLimit        Int
  publishStatus    String   @default("PENDING")
  publishedAt      DateTime?
  externalPostId   String?
  externalUrl      String?

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  analytics Analytics[]
}

model Analytics {
  id         String   @id @default(uuid())
  views      Int      @default(0)
  engagement Int      @default(0)
  clicks     Int      @default(0)
  shares     Int      @default(0)
  date       DateTime @default(now())

  postPlatform   PostPlatform @relation(fields: [postPlatformId], references: [id], onDelete: Cascade)
  postPlatformId String
}
