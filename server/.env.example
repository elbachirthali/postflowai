# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Railway, Supabase, Neon, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postflow_prod"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_a_strong_random_secret"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN="https://postunivers.com,https://www.postunivers.com"

# ─── AI (Claude) ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Paddle Billing ───────────────────────────────────────────────────────────
PADDLE_SECRET_KEY="pdl_sdbx_..."
PADDLE_WEBHOOK_SECRET="pdl_ntfset_..."
# Set to "sandbox" for testing, "production" for live
PADDLE_ENVIRONMENT="sandbox"
CLIENT_URL="https://postunivers.com"
